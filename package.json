{
  "name": "aidos-ui",
  "version": "5.0.3",
  "description": "An opinionated React component library with built-in theming and CSS-in-JS",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "css-in-js"
  ],
  "homepage": "https://aidos-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/germtb/aidos-ui.git"
  },
  "bugs": {
    "url": "https://github.com/germtb/aidos-ui/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    },
    "./vite-plugin-jss-debug": {
      "types": "./dist/vite-plugin-jss-debug.d.ts",
      "import": "./dist/vite-plugin-jss-debug.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons:types": "node ./scripts/generate-icon-types.mjs",
    "dev": "next dev docs",
    "publish:patch": "node ./scripts/publish.js --patch",
    "build": "next build docs --webpack",
    "build:lib": "tsup",
    "prepack": "npm run build:lib",
    "tsc": "tsc --noEmit && tsc --project docs/tsconfig.json --noEmit",
    "tsc:watch": "tsc --noEmit --watch",
    "start": "next start docs",
    "lint": "eslint src docs --max-warnings=0",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test:popover": "node --test tests/Popover.e2e.test.mjs"
  },
  "type": "module",
  "author": "Gerard Moreno-Torres Bertran",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@iconify-json/lucide": "^1.2.121",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.12",
    "@types/node": "^25.0.10",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "csstype": "^3.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "geist": "^1.7.2",
    "next": "^16.2.12",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "publint": "^0.3.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  }
}
